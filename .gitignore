# ===========================================
# DroneHub Australia — Backend .gitignore
# Laravel 11 + PHP 8.3 + Composer
# ===========================================

# Composer Dependencies
/vendor/

# Environment (NEVER commit secrets, API keys, DB passwords)
.env
.env.backup
.env.production

# Laravel Generated Files
/storage/*.key
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*.log
!/storage/logs/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# Compiled PHP
*.phpunit.result.cache
.phpunit.cache/

# IDE / Editor
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php

# OS Files
.DS_Store
Thumbs.db
Desktop.ini

# Node (if Laravel Mix / Vite used in backend)
/node_modules/
npm-debug.log*
yarn-debug.log*
/public/hot
/public/build/
/public/storage

# Testing
/coverage/
.phpunit.result.cache

# Misc
*.bak
*.tmp
*.log
Homestead.json
Homestead.yaml
auth.json
