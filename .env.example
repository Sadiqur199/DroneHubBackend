APP_NAME="DroneHub Australia"
APP_ENV=local
APP_KEY=base64:7Kq8hH8iU6Z4vV9zQxP2kL1mN0bC3dE5fG7hJ9kL1mN=
APP_DEBUG=true
APP_TIMEZONE=Australia/Brisbane
APP_URL=http://localhost:8000
APP_LOCALE=en_AU
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL 8)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dronehub
DB_USERNAME=dronehub_user
DB_PASSWORD=dronehub_secret

# Session & Cache & Queue (Redis)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=dronehub_cache

# Redis connection
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (Mailpit for local dev, Mailgun/SES for production)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="enquiries@dronehub.com.au"
MAIL_FROM_NAME="DroneHub Australia"

# Store & Australian Tax Details
STORE_NAME="DroneHub Australia"
STORE_ABN="48 612 908 124"
STORE_PHONE="1300 544 968"
STORE_EMAIL="enquiries@dronehub.com.au"
STORE_ADDRESS_LINE1="Cnr Gordon & Gregory Streets"
STORE_SUBURB="Mackay"
STORE_STATE="QLD"
STORE_POSTCODE="4740"
STORE_COUNTRY="Australia"
STORE_GST_RATE=10.00
STORE_CURRENCY=AUD

# Cloudflare R2 / S3-compatible Object Storage (Railway ephemeral storage rule)
AWS_ACCESS_KEY_ID=your_r2_access_key
AWS_SECRET_ACCESS_KEY=your_r2_secret_key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=dronehub-media-production
AWS_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=https://media.dronehub.com.au

# Stripe & Afterpay via Stripe
STRIPE_KEY=pk_test_placeholder_key
STRIPE_SECRET=sk_test_placeholder_secret
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_CURRENCY=aud

# Shipping Carriers (Australia Post / Sendle API)
AUSPOST_API_KEY=
AUSPOST_API_PASSWORD=
AUSPOST_ACCOUNT_NO=

# Security & Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Trusted Proxies (Cloudflare & Railway proxy)
TRUSTED_PROXIES=*

# Vite
VITE_APP_NAME="${APP_NAME}"
VITE_STORE_PHONE="1300 544 968"
VITE_STORE_EMAIL="enquiries@dronehub.com.au"
